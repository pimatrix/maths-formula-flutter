{
  "rewrites": [
    { "destination": "/index.html", "source": "/MathMitra" },
    { "destination": "/index.html", "source": "/MathMitra/" },
    { "destination": "/:path*", "source": "/MathMitra/:path*" }
  ],
  "headers": [
    {
      "source": "/canvaskit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/MathMitra/canvaskit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/assets/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/MathMitra/assets/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
